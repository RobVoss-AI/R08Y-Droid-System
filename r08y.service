[Unit]
Description=R08Y Droid System
After=network-online.target sound.target user@@R08Y_UID@.service
Wants=network-online.target user@@R08Y_UID@.service

[Service]
Type=simple
User=@R08Y_USER@
Group=@R08Y_GROUP@
WorkingDirectory=@R08Y_INSTALL_DIR@
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=/run/user/@R08Y_UID@
EnvironmentFile=-/etc/r08y/r08y.env
ExecStartPre=@R08Y_INSTALL_DIR@/venv/bin/python -m r08y --config @R08Y_INSTALL_DIR@/config.yaml --check-config
ExecStart=@R08Y_INSTALL_DIR@/venv/bin/python -m r08y --config @R08Y_INSTALL_DIR@/config.yaml
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
KillSignal=SIGTERM
KillMode=mixed
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
